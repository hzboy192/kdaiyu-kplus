<?xml version="1.0" encoding="UTF-8"?>
<!--日志级别从低到高优先级为：ALL < TRACE < DEBUG < INFO < WARN < ERROR < FATAL < OFF。-->
<!--status：设置 log4j2 自身内部的信息输出，可以不设置-->
<!--monitorInterval：监视配置文件变化间隔时间，单位秒，Log4j2 能够自动检测配置文件是否修改，同时更新配置-->
<configuration monitorInterval="30">
    <properties>
        <!--
        输出日志的格式
            %d表示日期时间
            %thread表示线程名，可简写为 %t
            %-5level：日志级别从左显示5个字符宽度
            %p：也表示日志级别
            %logger{50} 表示logger名字最长50个字符，否则按照句点分割。
            %l：输出日志事件的发生位置，包括：类名、函数名，以及在代码中的行数
            %c：日志消息所在类名
            %M：输出执行方法
            %line：表示行号
            %L：代码中的行数
            %msg：日志消息，可以简写为 %m
            %n是换行符
        日期输出要加时区，或者在jar执行参数中加-Duser.timezone=Asia/Shanghai 。否则日志输出日期时间不准确。
        -->
        <property name="log.pattern"
                  value="%d{yyyy-MM-dd HH:mm:ss.SSS} [%-5level] %logger{50}:%line - %msg%n"/>
        
        <property name="log.file.name.suffix" value="%d{yyyy-MM-dd}-%i.log"/>
    </properties>
    
    <!--先定义所有的 appender 附加器-->
    <appenders>
        <!--控制台输出配置-->
        <console name="CONSOLE-LOG" target="SYSTEM_OUT">
            <PatternLayout pattern="${log.pattern}"/>
        </console>
        
        
        <!--文件存储文件设置-->
        <!--fileName：文件存储路径及名称，可以是绝对路径或者相对路径; 存储的永远是最新的日志信息-->
        <!--filePattern：当 fileName 指定的文件大小超过限制，就会根据此文件名规则新建存档目录与文件，同时将 fileName 文件中的
         内容剪切到存档文件中，如下配置，会新建存档路径 logs/2021-06/2021-06-01-1.log -->
        <RollingFile name="FILE-LOG" fileName="logs/app.log" filePattern="logs/%d{yyyy-MM}/app-${log.file.name.suffix}">
            <!--日志文件中日志信息的格式-->
            <PatternLayout pattern="${log.pattern}"/>
            <Policies>
                <TimeBasedTriggeringPolicy/>
                <!--日志文件大小超过多少时进行存档-->
                <SizeBasedTriggeringPolicy size="500 MB"/>
            </Policies>
        </RollingFile>
        
        <RollingFile name="FILE-ERROR" fileName="logs/error.log"
                     filePattern="logs/%d{yyyy-MM}/error-${log.file.name.suffix}">
            <!--日志文件中日志信息的格式-->
            <PatternLayout pattern="${log.pattern}"/>
            <Policies>
                <TimeBasedTriggeringPolicy/>
                <!--日志文件大小超过多少时进行存档-->
                <SizeBasedTriggeringPolicy size="500 MB"/>
            </Policies>
            <!-- 过滤ERROR级别日志存储error.log -->
            <LevelMatchFilter level="ERROR" onMatch="ACCEPT" onMismatch="DENY"/>
        </RollingFile>
    </appenders>

    <!--
    1、root与logger是父子关系，没有特别定义logger的都默认为root。
    2、任何一个类只会和一个logger对应，要么是定义的logger，要么是root，判断的关键在于找到这个logger，然后判断这个logger的appender和level。
    3、appender-ref 用于引用上面定义好的 appender 日志追加器，只有引用了，上面的 appender 才能生效. -->
    <loggers>
        <!--过滤掉spring和mybatis的一些无用的DEBUG信息-->
        <logger name="org.mybatis" level="ERROR" additivity="false">
            <AppenderRef ref="CONSOLE-LOG"/>
        </logger>
        <!-- SQL打印：只在控制台打印。mybatis-flex该配置无效。 -->
        <logger name="java.sql" level="ERROR">
            <AppenderRef ref="CONSOLE-LOG"/>
        </logger>
        
        <!--若是additivity设为false，则 子Logger 只会在自己的appender里输出，而不会在 父Logger 的appender里输出。-->
        <Logger name="org.springframework" level="ERROR" additivity="false">
            <AppenderRef ref="CONSOLE-LOG"/>
        </Logger>
        
        <!-- 应用日志级别有maven通过构建环境来设置，正式环境为INFO -->
        <logger name="cn.kdaiy" level="DEBUG"/>
        
        <root level="INFO">
            <AppenderRef ref="CONSOLE-LOG"/>
            <!-- 正式环境放开注释
            <AppenderRef ref="FILE-LOG"/>
            <AppenderRef ref="FILE-ERROR"/> 
            -->
        </root>
    </loggers>
</configuration>